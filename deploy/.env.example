# Copy to .env and fill in. Never commit .env.

# Cloudflare Tunnel token from the Zero Trust dashboard.
# Create a tunnel, add a public hostname api.fetchandscore.com pointing at
# http://api:8080, then paste its token here.
CLOUDFLARE_TUNNEL_TOKEN=

# Mailgun, for sign-in links.
FNS_MAILGUN_DOMAIN=mg.fetchandscore.com
FNS_MAILGUN_API_KEY=
FNS_MAIL_FROM=Fetch and Score <no-reply@fetchandscore.com>

# Public origins. FNS_ALLOWED_ORIGIN is the only origin allowed to call the
# API with credentials, so it must match where the site is served from.
FNS_BASE_URL=https://fetchandscore.com
FNS_ALLOWED_ORIGIN=https://fetchandscore.com

# Image tag to run.
FNS_IMAGE_TAG=latest
